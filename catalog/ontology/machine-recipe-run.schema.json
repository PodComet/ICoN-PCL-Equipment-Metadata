{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/ontology/machine-recipe-run.schema.json",
  "title": "ICoN-PCL machine, recipe and manufacturing-run token profile",
  "description": "Three primary tokens: physical-machine UUID, exact-byte recipe SHA-256 and run UUID. Supports several machines per recipe, several sequences per step and repeated runs. This schema does not implement a scheduler or device driver.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "iconpcl-machine-recipe-run/v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Machine"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecipeReference"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Run"
      }
    }
  },
  "required": [
    "profile",
    "scope",
    "machines",
    "recipes",
    "runs"
  ],
  "$defs": {
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri",
        "sha256",
        "media_type"
      ]
    },
    "Quantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "unit_uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "unit_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "unit_uri",
        "unit_text"
      ]
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameter_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "specified",
            "unresolved"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "parameter_id",
        "value",
        "unit_uri",
        "unit_text",
        "status",
        "source_ids"
      ]
    },
    "MachineRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "category_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "catalog_equipment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "role_id",
        "category_ids",
        "catalog_equipment_ids",
        "required_capabilities"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "fiber": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "definition_status": {
          "enum": [
            "illustrative_unverified",
            "documented_model_bound"
          ]
        },
        "operation_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "action_id",
        "position",
        "fiber",
        "direction",
        "definition_status",
        "operation_reference",
        "parameters",
        "source_ids"
      ]
    },
    "InstructionSequence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence_id": {
          "type": "string",
          "minLength": 1
        },
        "machine_role": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Action"
          }
        }
      },
      "required": [
        "sequence_id",
        "machine_role",
        "actions"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "prerequisite_step_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instruction_sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstructionSequence"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        }
      },
      "required": [
        "step_id",
        "label",
        "prerequisite_step_ids",
        "instruction_sequences",
        "parameters"
      ]
    },
    "LatentGeometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "tokenizer_version": {
          "type": "string",
          "minLength": 1
        },
        "decoder_checkpoint": {
          "$ref": "#/$defs/Artifact"
        },
        "prefix_length_k": {
          "type": "integer",
          "minimum": 1
        },
        "latent_width": {
          "type": "integer",
          "minimum": 1
        },
        "refinement_count_l": {
          "type": "integer",
          "minimum": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "normalization_and_inverse_transform": {
          "type": "string",
          "minLength": 1
        },
        "mesh_extraction_settings": {
          "type": "string",
          "minLength": 1
        },
        "reconstruction_validation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact",
        "tokenizer_version",
        "decoder_checkpoint",
        "prefix_length_k",
        "latent_width",
        "refinement_count_l",
        "dtype",
        "normalization_and_inverse_transform",
        "mesh_extraction_settings",
        "reconstruction_validation"
      ]
    },
    "Geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design": {
          "$ref": "#/$defs/Artifact"
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Quantity"
          }
        },
        "tolerances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "build_orientation": {
          "type": "string",
          "minLength": 1
        },
        "latent_representation": {
          "$ref": "#/$defs/LatentGeometry"
        }
      },
      "required": [
        "design",
        "shape",
        "coordinate_frame",
        "dimensions",
        "tolerances",
        "build_orientation"
      ]
    },
    "InputRole": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "material",
            "utility",
            "data"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role_id",
        "kind",
        "required",
        "description"
      ]
    },
    "OutputSpecification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "geometry_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "output_role",
        "description",
        "geometry_ref",
        "acceptance_criteria"
      ]
    },
    "RecipeManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "iconpcl-recipe-manifest/v1"
        },
        "recipe_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "workflow_kind": {
          "enum": [
            "manufacturing_3d",
            "manufacturing",
            "computational",
            "characterization"
          ]
        },
        "scope": {
          "enum": [
            "illustrative_draft",
            "validated_model_bound"
          ]
        },
        "process_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "machine_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/MachineRole"
          }
        },
        "input_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputRole"
          }
        },
        "material_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completion_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputSpecification"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "profile",
        "recipe_id",
        "revision",
        "label",
        "workflow_kind",
        "scope",
        "process_ids",
        "machine_roles",
        "input_roles",
        "steps",
        "preconditions",
        "completion_signals",
        "expected_outputs",
        "source_ids"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "workflow_kind": {
                "const": "manufacturing_3d"
              }
            }
          },
          "then": {
            "required": [
              "geometry"
            ]
          }
        }
      ]
    },
    "Controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "configuration_artifact": {
          "$ref": "#/$defs/Artifact"
        }
      },
      "required": [
        "endpoint",
        "protocol"
      ]
    },
    "Machine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_token": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "catalog_equipment_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "registration_status": {
          "enum": [
            "illustrative_identity",
            "registered_physical_unit"
          ]
        },
        "registry_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "controller": {
          "anyOf": [
            {
              "$ref": "#/$defs/Controller"
            },
            {
              "type": "null"
            }
          ]
        },
        "driver": {
          "anyOf": [
            {
              "$ref": "#/$defs/Artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "machine_token",
        "catalog_equipment_id",
        "label",
        "registration_status",
        "registry_uri",
        "controller",
        "driver",
        "interfaces",
        "evidence_ids"
      ]
    },
    "RecipeReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipe_token": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifest_uri": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "hash_profile": {
          "const": "sha256-exact-manifest-bytes/v1"
        }
      },
      "required": [
        "recipe_token",
        "manifest_uri",
        "hash_profile"
      ]
    },
    "MachineBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine_role": {
          "type": "string",
          "minLength": 1
        },
        "machine_token": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "configuration": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        }
      },
      "required": [
        "machine_role",
        "machine_token",
        "configuration"
      ]
    },
    "MaterialBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_role": {
          "type": "string",
          "minLength": 1
        },
        "material_id": {
          "type": "string",
          "minLength": 1
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "binding_status": {
          "enum": [
            "illustrative_planned",
            "verified_loaded",
            "actual_consumed"
          ]
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        }
      },
      "required": [
        "input_role",
        "material_id",
        "batch_id",
        "quantity",
        "binding_status",
        "properties"
      ]
    },
    "UtilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        }
      },
      "required": [
        "input_role",
        "description",
        "parameters"
      ]
    },
    "DataBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_role": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      },
      "required": [
        "input_role",
        "artifact"
      ]
    },
    "InstructionExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_id": {
          "type": "string",
          "minLength": 1
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "planned",
            "running",
            "completed",
            "failed",
            "aborted"
          ]
        },
        "actual_parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "execution_id",
        "step_id",
        "sequence_id",
        "action_ids",
        "status",
        "actual_parameters",
        "evidence_ids"
      ]
    },
    "Specimen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "output_role": {
          "type": "string",
          "minLength": 1
        },
        "geometry_ref": {
          "type": "string",
          "minLength": 1
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        }
      },
      "required": [
        "specimen_id",
        "output_role",
        "geometry_ref",
        "measurements"
      ]
    },
    "Readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "blocked",
            "ready"
          ]
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "missing_requirements"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_token": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "recipe_token": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "illustrative_planned",
            "recorded_execution"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "ready",
            "running",
            "completed",
            "failed",
            "aborted"
          ]
        },
        "machine_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MachineBinding"
          }
        },
        "material_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialBinding"
          }
        },
        "utility_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UtilityBinding"
          }
        },
        "data_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataBinding"
          }
        },
        "parameter_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "instruction_executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstructionExecution"
          }
        },
        "execution_readiness": {
          "$ref": "#/$defs/Readiness"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "expected_specimens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Specimen"
          }
        },
        "generated_specimens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Specimen"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "run_token",
        "recipe_token",
        "label",
        "scope",
        "status",
        "machine_bindings",
        "material_bindings",
        "utility_bindings",
        "data_bindings",
        "parameter_bindings",
        "instruction_executions",
        "execution_readiness",
        "expected_specimens",
        "generated_specimens",
        "artifacts",
        "deviations"
      ]
    }
  },
  "x-hash-policy": {
    "id": "sha256-exact-manifest-bytes/v1",
    "algorithm": "SHA-256",
