    schema:propertyID "outputs_and_states" ;
    schema:value """Repositioned specimens/plates between instruments or stages. Position, force, status and output-pin mappings require the actual controller/model documentation.
Source: Instrument Inventory Table (final).docx, Automation / FANUC CRX-10iA entry.""" .

<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/REQ-EQ-044%3Aunits_of_measure> a schema:PropertyValue ;
