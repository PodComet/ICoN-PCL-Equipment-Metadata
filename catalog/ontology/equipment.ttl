    schema:name "Input and input states" ;
    schema:propertyID "inputs_and_states" ;
    schema:value """Workload: mounted tool/load and robot program. Controls: Manual/Automatic mode; jog/lead-through commands; program start/stop and motors-on requests. Collision-avoidance system input is documented as HIGH=active, LOW=inactive. Other configured I/O requires the controller configuration.
Source: H, PDF pp. 19–28, 32, 35, 39, 50–51.""" .

<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/REQ-EQ-017%3Aoutputs_and_states> a schema:PropertyValue ;
