<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M86-62BA2209CDF0%3Ainputs_and_states> a schema:PropertyValue ;
    prov:wasDerivedFrom <https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M86-62BA2209CDF0> ;
    schema:name "Input and input states" ;
    schema:propertyID "inputs_and_states" ;
    schema:value """14 analog inputs (AIN0–AIN13); 20 configurable digital I/O; USB power/host commands; gain/channel configuration and timer/counter inputs. Digital input states: LOW −0.3–0.8 V, HIGH 2–5.8 V; analog input range depends on gain. No material feed is used.
Source: H, U6 datasheet §2 and Appendix A (linked subsections).
https://support.labjack.com/docs/2-hardware-description-u6-datasheet ; https://support.labjack.com/docs/appendix-a-specifications-u6-datasheet""" .

<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M86-62BA2209CDF0%3Aoutputs_and_states> a schema:PropertyValue ;
    prov:wasDerivedFrom <https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M86-62BA2209CDF0> ;
    schema:name "Output and output states" ;
    schema:propertyID "outputs_and_states" ;
    schema:value """USB measurement data; DAC0/DAC1 analog outputs; configurable digital outputs/PWM/timers; VS supply and 10/200 µA current-source outputs. Digital output states HIGH/LOW are load-dependent; nominal no-load HIGH is 3.3 V and LOW 0 V.
Source: H, U6 datasheet §2 and Appendix A (linked subsections).
https://support.labjack.com/docs/2-hardware-description-u6-datasheet ; https://support.labjack.com/docs/appendix-a-specifications-u6-datasheet""" .

<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M86-62BA2209CDF0%3Aunits_of_measure> a schema:PropertyValue ;
    prov:wasDerivedFrom <https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M86-62BA2209CDF0> ;
    schema:name "Measuring units" ;
    schema:propertyID "units_of_measure" ;
    schema:value """V, mV/µV, mA/µA/nA; Ω/kΩ/GΩ; Hz/MHz; s/ms/µs; bits, counts, edges/s, %, ppm/°C and °C (as applicable to the measured/configured channel)
Source: H, U6 datasheet §2 and Appendix A (linked subsections).
https://support.labjack.com/docs/2-hardware-description-u6-datasheet ; https://support.labjack.com/docs/appendix-a-specifications-u6-datasheet""" .

