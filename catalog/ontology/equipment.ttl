<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment> a dcat:Dataset ;
    rdfs:label "ICoN-PCL Nanomaterial Equipment Ontology — equipment records" ;
    dct:conformsTo <https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/blob/main/catalog/metadata-profile.json> ;
    dct:description "One resource per catalog equipment ID, representing a model or category-context record, not a count of physical assets. Variants and repeated model contexts are retained. Catalog process/material associations do not establish exact-model suitability. Input/output and unit descriptions preserve source text; they are not parsed into an executable control interface. Prices are dated source quotes or explicitly labeled estimates, not live offers. No private inventory, serial numbers, saved workflows or source document files are included." ;
    dct:identifier "equipment" ;
    dct:issued "2026-11-04"^^xsd:date ;
    dct:rights "Code license is in the repository LICENSE. Linked third-party manuals, photographs and source material retain their own rights; this export does not relicense them." ;
