{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICoN-PCL model-bound instrument operation v1",
  "description": "Optional Direction.operation within poly-fibers/v2. Planning metadata, no device execution. Application also enforces unique IDs, ordered bounds, typed choices, known evidence and model-bound transition targets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_ids",
    "parameters",
    "preconditions",
    "completion_signals"
  ],
  "properties": {
    "schema": {
      "const": "instrument-operation/v1"
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Must resolve in the model evidence register; enforced by application validation."
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type",
          "required",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,99}$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "enum": [
              "number",
              "integer",
              "string",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Must resolve in the model evidence register; enforced by application validation."
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "number",
                    "integer"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "unit"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "unit"
                    ]
                  },
                  {
                    "required": [
                      "minimum"
                    ]
                  },
                  {
                    "required": [
                      "maximum"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "preconditions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,99}$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Must resolve in the model evidence register; enforced by application validation."
            }
          }
        }
      }
    },
    "completion_signals": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,99}$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Must resolve in the model evidence register; enforced by application validation."
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_success",
        "evidence_ids"
      ],
      "properties": {
        "on_success": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "on_failure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Must resolve in the model evidence register; enforced by application validation."
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "command",
        "evidence_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "python_api",
            "serial",
            "http",
            "manual"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Must resolve in the model evidence register; enforced by application validation."
          }
        }
      }
    }
  }
}
