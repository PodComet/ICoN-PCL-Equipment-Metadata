Source: Manuals/Raith_EBPG5150_-_Operation_Guide.pdf, PDF p. 1.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M59-05"/>
