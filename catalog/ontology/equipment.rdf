  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P39">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#Route"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#ManufacturingProcess"/>
    <dct:identifier>P39</dct:identifier>
    <rdfs:label>Hydrothermal growth of zinc-oxide/cellulose nanohybrids</rdfs:label>
    <skos:notation>P39</skos:notation>
    <icon:associationBasis>Reviewed methods of 10.1021/acsomega.8b01881. ZnO particles below approximately 20–25 nm on cellulose rods about 5 nm wide. Hop 2 via a directly cited 2024 review; upstream coating refers to another paper and is not independently validated here.</icon:associationBasis>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M58-06">
