  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/REQ-EQ-007%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
