  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/evidence/CAT-EV-0DDAB067E1BAAF8D">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#SourceEvidence"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:identifier>CAT-EV-0DDAB067E1BAAF8D</dct:identifier>
    <rdfs:label>Theris identifies Theris MSF mass filter in its official product documentation.</rdfs:label>
    <icon:claim>Theris identifies Theris MSF mass filter in its official product documentation.</icon:claim>
    <icon:classification>curator_reviewed_catalog</icon:classification>
    <icon:scope>In-line quadrupole mass-analysis/filter accessory for NanoStream sources. Manufacturer product claims only. P/N links express curator relevance, not source-article apparatus, measured performance, exact host compatibility or mandatory process steps. In-line quadrupole accessory for NanoStream beams; the manufacturer image filename MFS is not a second model. Webpage mass-limit exponent is corrupted; refer to NanoStream brochure pages 4 and 6 instead. No aerosol-mobility or general mass-spectrometer equivalence. Public purchase price and exact-model operating manual were not published in this bounded review. No documented successor relationship or newest-generation claim. No make/model match in the user-designated Purdue list; generic PVD wording is not asset identity.</icon:scope>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/evidence_registry.csv"/>
    <prov:wasDerivedFrom rdf:resource="https://therisnano.com/nanostream-nanoparticle-deposition-sources/"/>
    <prov:wasDerivedFrom rdf:resource="https://therisnano.com/wp-content/uploads/2025/10/NanoStream-Brochure-2025-1.pdf"/>
    <dct:source rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/evidence-source/CAT-EV-0DDAB067E1BAAF8D%3A1"/>
    <dct:source rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/evidence-source/CAT-EV-0DDAB067E1BAAF8D%3A2"/>
  </rdf:Description>
