  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M14-01">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#InputOutputProfile"/>
    <dct:identifier>M14-01</dct:identifier>
    <rdfs:label>Beckman Coulter Optima XPN-100 — input/output metadata</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv"/>
    <icon:inputDescription>Materials/workload: Samples in approved tubes/containers; compatible rotor/buckets and run settings.
Documented parameters/utilities: Temperature setting/range (°C), Electrical supply (A; Hz; V).
Interfaces named: Ethernet, ethernet, USB. Pin directions and permitted commands require the interface section.
Source-described sample/feed form: liquid sample.
Other per-input states/guards: not established by this functional summary.
Sources: H PDF pp. 1, 36, 212.
Additional documented controls/states: lid opening/locking control.
Source: Manuals/Beckman Coulter Optima XPN-100__linked-manual__ce9fefcfaf.pdf, PDF p. 23.</icon:inputDescription>
    <icon:outputDescription>Centrifuged samples/fractions; actual separation and recovery are sample-dependent.
Source-listed channels/measurands: speed, temperature, time, imbalance.
Status terms explicitly described: ready, running, error.
Other output-state/pin mappings: not established by this functional summary.
Sources: H PDF pp. 1, 36, 212.</icon:outputDescription>
    <icon:measuringUnitsDescription>A; Hz; V; kW; °C
Sources: H PDF pp. 36, 38, 211, 212, 219, 220, 222, 223.</icon:measuringUnitsDescription>
    <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
    <icon:sourceSheet>Sheet1</icon:sourceSheet>
    <icon:sourceRow>127</icon:sourceRow>
    <icon:sourceModel>Beckman Coulter Optima XPN-100</icon:sourceModel>
    <icon:importedDate>2026-10-30</icon:importedDate>
    <dct:references rdf:resource="https://www.beckmancoulter.com/download/file/wsr-128301/B08094AM?type=pdf"/>
  </rdf:Description>
