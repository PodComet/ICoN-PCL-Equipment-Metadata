  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M07-01">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#InputOutputProfile"/>
    <dct:identifier>M07-01</dct:identifier>
    <rdfs:label>New Era NE-300 InfusionONE — input/output metadata</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv"/>
    <icon:inputDescription>Syringe contents: Sample in a compatible syringe; compatibility not specified; states: Loaded syringe; phase: Fluid; composition not prescribed
DC input: 12 V DC; 750 mA maximum; specified regulated adapter rated 1000 mA; states: Connected/disconnected
Syringe diameter: 0.100–50.00 mm; states: Set while stopped
Infusion rate: 0.73 µL/h (1 mL B-D syringe) to 1257 mL/h (60 mL B-D syringe); states: Numeric rate; 0.0 stops pumping; limits depend on syringe
Start/stop and purge keys: Start/Stop key and reverse-purge key; states: Stopped, infusion, forward purge, reverse purge; held-key purge stops on release
Power-failure restart and low-noise modes: Independent binary setup options; states: 0=disabled; 1=enabled</icon:inputDescription>
    <icon:outputDescription>Dispensed fluid: Continuous infusion until stopped; reverse purge is an unjamming function; states: Infusing/stopped/purging; phase: Fluid in connected syringe/tubing
Display and LEDs: Rate, syringe diameter, accumulated dispensed volume and status; states: Pumping indicator, units-selection indication, purge/reverse-purge indication and out-of-range indication</icon:outputDescription>
    <icon:measuringUnitsDescription>V; boolean; mA; mL; mL/h; mL/hr; mL/min; mm; s; µL; µL/h; µL/min; μL</icon:measuringUnitsDescription>
    <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
    <icon:sourceSheet>Sheet1</icon:sourceSheet>
