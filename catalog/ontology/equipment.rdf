    <icon:brandIdentityStatus>needs_review</icon:brandIdentityStatus>
    <icon:researchUseStatus>needs_review</icon:researchUseStatus>
    <icon:verificationNotes>Historical Baxter manufacturer; marked defunct at the project owner's request, reviewed 2026-10-15. Original closure reporting: https://spectrum.ieee.org/rethink-robotics-pioneer-of-collaborative-robots-shuts-down . Later closure reporting (September 16, 2025): https://www.therobotreport.com/rethink-robotics-shuts-down-again/ ; indexed summary available at https://www.riemnews.com/en/news/rethink-robotics-shuts-down-again-2r9E6grW . Archived SDK repositories establish historical provenance, not an operating manufacturer or current support.</icon:verificationNotes>
    <icon:companyStatus>defunct</icon:companyStatus>
    <icon:companyStatusNote>Rethink Robotics is defunct. The original Baxter-era company closed in 2018; a relaunched Rethink Robotics business was reported closed again in 2025. Baxter is retained as a legacy instrument. Current OEM support and spare-parts availability have not been confirmed.</icon:companyStatusNote>
    <icon:reviewDate>2026-10-15</icon:reviewDate>
    <schema:url rdf:resource="https://github.com/RethinkRobotics/baxter_examples"/>
    <icon:researchEvidenceURL rdf:resource="https://github.com/RethinkRobotics/baxter_examples"/>
    <icon:companyStatusSource rdf:resource="https://www.therobotreport.com/rethink-robotics-shuts-down-again/"/>
  </rdf:Description>
