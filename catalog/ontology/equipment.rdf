  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/oceanoptics">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#Manufacturer"/>
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <dct:identifier>oceanoptics</dct:identifier>
    <rdfs:label>Ocean Optics</rdfs:label>
    <icon:brandIdentityStatus>verified_manufacturer</icon:brandIdentityStatus>
    <icon:researchUseStatus>documented_research_use</icon:researchUseStatus>
    <icon:verificationBasis>independent_research_evidence</icon:verificationBasis>
    <icon:verificationNotes>Official history dates the company to 1989, Halma acquisition to 2004, the Ocean Insight rebranding to 2019 and restoration of the Ocean Optics spectrometer brand to 2023. Current company page identifies Halma ownership. Ocean Insight is a historically related parent/umbrella name, not evidence that Ocean Optics is defunct. Preserve paper-era Ocean Optics attribution for Flame. Official brand identity and model-specific primary-paper research use checked separately; no adoption-prevalence claim.</icon:verificationNotes>
    <icon:companyStatusNote>Parent / corporate successor: Halma plc. Ocean Insight is a historically related parent/umbrella name, not evidence that Ocean Optics is defunct. Preserve paper-era Ocean Optics attribution for Flame.</icon:companyStatusNote>
    <icon:reviewDate>2026-10-17</icon:reviewDate>
    <schema:url rdf:resource="https://www.oceanoptics.com/about/"/>
    <icon:researchEvidenceURL rdf:resource="https://pmc.ncbi.nlm.nih.gov/articles/PMC7265452/"/>
    <icon:companyStatusSource rdf:resource="https://www.oceanoptics.com/about/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/SW17-M35-0B6C77913DB3%3Aunits_of_measure">
