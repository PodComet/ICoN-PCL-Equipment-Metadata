  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M92-CBD11FF174E1%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Materials/workload: Prepared elemental-analysis sample and specified plasma/sample-introduction utilities. Documented utilities/settings: cooling supply, flow setting/range, gas/air supply, pressure setting/range. Family document; numeric limits/options must be checked for this variant.
Source: Manuals/PYL-Avio-220-Max-ICP-OES-Preparing-Your-Lab-135914.pdf, PDF p. 1, 2, 4, 7.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M92-CBD11FF174E1"/>
  </rdf:Description>
