    <dct:identifier>PRICE-EV-B781A831788822DB</dct:identifier>
    <rdfs:label>Fisher Scientific US publishes USD 6582.1 for Kinematica POLYTRON PT 3100 D (published_price; new).</rdfs:label>
    <icon:claim>Fisher Scientific US publishes USD 6582.1 for Kinematica POLYTRON PT 3100 D (published_price; new).</icon:claim>
