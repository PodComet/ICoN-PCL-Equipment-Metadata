  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/M07-08%3Aunits_of_measure">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Measuring units</schema:name>
    <schema:propertyID>units_of_measure</schema:propertyID>
    <schema:value>Flow-rate command units: pL, nL, µL or mL per second, minute or hour (syringe-dependent limits). Syringe/target and infused/withdrawn volume: µL or mL; syringe diameter: mm. Time: s and h:m:s. Raw serial STATUS: fL/s (rate), ms (time), fL (volume), plus dimensionless state flags. Electrical supply/I/O ratings: V/VAC, Hz, W, µA and mA; TTL HIGH/LOW and direction/run/target flags are dimensionless. Scope: Legato 210 using the documented 200-series interface, not the 210P/270P analog option.
Source: Manuals/KDS Legato 200 Series_5617-002REV2.0.pdf, PDF pp. 6, 8, 11, 17–19, 62–65, 79, 89. Model scope: Legato 210 (788210).</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M07-08"/>
  </rdf:Description>
