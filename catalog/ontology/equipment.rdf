    <schema:name>Output and output states</schema:name>
    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Chassis translation/rotation; CAN feedback for actual linear/angular velocity, battery voltage, chassis/control-mode status, fault bits and motor information. Fault bits use 0=normal/no alarm and 1=fault/alarm. Feedback motor speed is in rpm; the side interface also provides 24 V expansion power.
Source: H, PDF pp. 3, 7–8, 11–19, 22–26, 34.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-043"/>
  </rdf:Description>
