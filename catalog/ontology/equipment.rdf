  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M94-AE8D51E118E0%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
