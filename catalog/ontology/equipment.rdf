    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Raman spectral/intensity data; imaging depends on the installed configuration. Documented readouts/functions: Raman spectra/maps. Family document; numeric limits/options must be checked for this variant.
Source: Manuals/269-373000 DXR3 SmartRaman+ Software and OPC-UA Configuration User Guide.pdf, PDF p. 1.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M40-09"/>
  </rdf:Description>
