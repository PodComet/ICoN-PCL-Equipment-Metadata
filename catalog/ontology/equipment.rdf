    <schema:propertyID>units_of_measure</schema:propertyID>
    <schema:value>rpm (speed); mL (volume); µL (volume); W (power); L/min (flow); bar (pressure); mL/min (flow)
Source: Manuals/flyer_3373169.pdf, PDF pp. 1, 2.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M06-09"/>
  </rdf:Description>
