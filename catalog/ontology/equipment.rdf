    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Materials/workload: Prepared specimen in the chamber; electron-beam, vacuum and scan conditions. Documented utilities/settings: electrical stimulus, time/duration.
Source: Manuals/thermo-scientific-axia-chemisem-datasheet-ds0354.pdf, PDF p. 1, 2, 3.</schema:value>
