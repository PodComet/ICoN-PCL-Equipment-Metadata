  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M70-OPENTRONS-GEN2%3Aoutputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Output and output states</schema:name>
    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Lid position: lid_position property; states: open; closed; in_between; unknown; optional None per API signature
Block temperature and status: block_temperature; block_temperature_status; states: holding at target; cooling; heating; idle; error
Lid temperature and status: lid_temperature; lid_temperature_status; states: holding at target; passive cooling; heating; idle; error; optional None
LED indication: White/orange/red/blue, solid or pulsing as specified; states: White=idle (may remain hot); pulsing orange=error; red=hot; blue=cool; solid=holding, pulsing=changing for red/blue
Temperature-cycled samples: Samples remain in the loaded labware; states: Thermal history follows the chosen protocol; yield/composition not determined by the module specification; phase: Protocol-dependent liquid samples</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M70-OPENTRONS-GEN2"/>
  </rdf:Description>
