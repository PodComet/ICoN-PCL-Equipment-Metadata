  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M16-07">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#InputOutputProfile"/>
    <dct:identifier>M16-07</dct:identifier>
    <rdfs:label>Heidolph Hei-VAP Expert — input/output metadata</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv"/>
    <icon:inputDescription>Materials/workload: Solvent-containing sample in the evaporation flask; heating and condenser/vacuum connections as specified. Documented utilities/settings: time/duration. Documented controls/states: start/stop controls. Family document; numeric limits/options must be checked for this variant.
Source: Manuals/Operation-Manual-Rotary Evaporator-Hei-VAP-Expert-Ultimate-Control.pdf, PDF p. 68, 77, 89, 92.</icon:inputDescription>
    <icon:outputDescription>Concentrated flask contents and recovered condensate in the documented evaporation arrangement. Family document; numeric limits/options must be checked for this variant.
Source: Manuals/Operation-Manual-Rotary Evaporator-Hei-VAP-Expert-Ultimate-Control.pdf, PDF p. 68.</icon:outputDescription>
    <icon:measuringUnitsDescription>rpm (speed); Hz (frequency); bar (pressure); °C (temperature); L (volume); mbar (pressure)
Source: Manuals/Operation-Manual-Rotary Evaporator-Hei-VAP-Expert-Ultimate-Control.pdf, PDF pp. 40, 72, 80, 86, 96.</icon:measuringUnitsDescription>
    <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
    <icon:sourceSheet>Sheet1</icon:sourceSheet>
