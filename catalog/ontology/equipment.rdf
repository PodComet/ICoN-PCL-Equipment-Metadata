  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/invitrogen">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#Manufacturer"/>
    <rdf:type rdf:resource="https://schema.org/Organization"/>
    <dct:identifier>invitrogen</dct:identifier>
    <rdfs:label>Invitrogen</rdfs:label>
    <icon:brandIdentityStatus>verified_brand</icon:brandIdentityStatus>
    <icon:researchUseStatus>documented_research_use</icon:researchUseStatus>
    <icon:verificationBasis>independent_research_evidence</icon:verificationBasis>
    <icon:verificationNotes>SEC primary filing documents operations from 1987; current Thermo Fisher portfolio identifies Invitrogen brand. Caltech-hosted RAP protocol independently names Invitrogen DynaMag2 for1.5mL tubes. Brand-level research evidence does not validate all particle formulations. Business-history source: https://www.sec.gov/Archives/edgar/data/1073431/000119312505035182/d10k.htm Current corporate brand source: https://corporate.thermofisher.com/content/tfcorpsite/us/en/index/about.html</icon:verificationNotes>
    <icon:reviewDate>2026-10-17</icon:reviewDate>
