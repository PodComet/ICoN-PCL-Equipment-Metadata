  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/evidence/CAT-EV-82B38E6C3FC5F08B">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#SourceEvidence"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:identifier>CAT-EV-82B38E6C3FC5F08B</dct:identifier>
    <rdfs:label>Theris identifies Theris NanoShell in its official product documentation.</rdfs:label>
    <icon:claim>Theris identifies Theris NanoShell in its official product documentation.</icon:claim>
    <icon:classification>curator_reviewed_catalog</icon:classification>
    <icon:scope>Core-shell coating accessory/module between NanoStream source and deposition chamber; includes electronics/software but is not the whole nanoparticle generation/deposition system. Manufacturer product claims only. P/N links express curator relevance, not source-article apparatus, measured performance, exact host compatibility or mandatory process steps. In-flight sputter-coating module requiring a compatible NanoStream source and deposition chamber. Two coating cathodes are described on the product page. It cannot replace a complete sputter coater or a NanoStream generator. General NanoStream brochure page 4 includes NanoShell; dedicated brochure is request-only in the reviewed source. Public purchase price and exact-model operating manual were not published in this bounded review. No documented successor relationship or newest-generation claim. No make/model match in the user-designated Purdue list; generic PVD wording is not asset identity.</icon:scope>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/evidence_registry.csv"/>
    <prov:wasDerivedFrom rdf:resource="https://therisnano.com/nanoshell-core-shell-coater/"/>
    <prov:wasDerivedFrom rdf:resource="https://therisnano.com/wp-content/uploads/2025/10/NanoStream-Brochure-2025-1.pdf"/>
    <dct:source rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/evidence-source/CAT-EV-82B38E6C3FC5F08B%3A1"/>
    <dct:source rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/evidence-source/CAT-EV-82B38E6C3FC5F08B%3A2"/>
  </rdf:Description>
