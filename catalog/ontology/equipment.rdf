  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/REQ-EQ-035%3Aoutputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Output and output states</schema:name>
    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Commanded robot/tool motion, rated reach 2 m, maximum TCP speed 4 m/s, repeatability ±0.025 mm. Control box: 16 digital outputs, 24 V / 0.7 A continuous; combined supply limit 3 A with internal power or 12 A with external power. Tool: 2 digital outputs, open-drain or push-pull (listed 1 A rating); zero analogue outputs; tool power 12/24 V, 6 A continuous maximum. The tool hardware/software-support caveat also applies to these outputs. Default states, per-pin assignments, fault/ready meanings and calibrated position/force telemetry fields are not supplied by the sheet.
Source: Manuals2/6ad0b7d901069695bb0263e1_New Thor Specs 202604.pdf, PDF p. 2.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-035"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/M07-07%3Aoutputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Output and output states</schema:name>
    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Infused liquid; pump/run indication, programmed trigger outputs where supported, completion and stall/power-failure messages. Family TTL outputs are Boolean high/low; only functions enabled by the installed Legato 200 configuration apply. No withdrawal stream is produced by this infuse-only model.
Source: Manuals/KDS Legato 200 Series_5617-002REV2.0.pdf, PDF pp. 6, 8, 11, 17–19, 62–65, 79, 89.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M07-07"/>
  </rdf:Description>
