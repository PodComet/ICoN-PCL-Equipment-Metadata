  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M86-62BA2209CDF0">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#InputOutputProfile"/>
    <dct:identifier>EXT-M86-62BA2209CDF0</dct:identifier>
    <rdfs:label>U6-Pro — input/output metadata</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv"/>
    <icon:inputDescription>14 analog inputs (AIN0–AIN13); 20 configurable digital I/O; USB power/host commands; gain/channel configuration and timer/counter inputs. Digital input states: LOW −0.3–0.8 V, HIGH 2–5.8 V; analog input range depends on gain. No material feed is used.
Source: H, U6 datasheet §2 and Appendix A (linked subsections).
https://support.labjack.com/docs/2-hardware-description-u6-datasheet ; https://support.labjack.com/docs/appendix-a-specifications-u6-datasheet</icon:inputDescription>
    <icon:outputDescription>USB measurement data; DAC0/DAC1 analog outputs; configurable digital outputs/PWM/timers; VS supply and 10/200 µA current-source outputs. Digital output states HIGH/LOW are load-dependent; nominal no-load HIGH is 3.3 V and LOW 0 V.
Source: H, U6 datasheet §2 and Appendix A (linked subsections).
https://support.labjack.com/docs/2-hardware-description-u6-datasheet ; https://support.labjack.com/docs/appendix-a-specifications-u6-datasheet</icon:outputDescription>
    <icon:measuringUnitsDescription>V, mV/µV, mA/µA/nA; Ω/kΩ/GΩ; Hz/MHz; s/ms/µs; bits, counts, edges/s, %, ppm/°C and °C (as applicable to the measured/configured channel)
Source: H, U6 datasheet §2 and Appendix A (linked subsections).
https://support.labjack.com/docs/2-hardware-description-u6-datasheet ; https://support.labjack.com/docs/appendix-a-specifications-u6-datasheet</icon:measuringUnitsDescription>
    <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
    <icon:sourceSheet>Sheet1</icon:sourceSheet>
    <icon:sourceRow>591</icon:sourceRow>
    <icon:sourceModel>LabJack U6-Pro</icon:sourceModel>
    <icon:importedDate>2026-10-30</icon:importedDate>
    <dct:references rdf:resource="https://support.labjack.com/docs/u6-datasheet"/>
    <dct:references rdf:resource="https://labjack.com/products/labjack-u6-pro"/>
  </rdf:Description>
