  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/REQ-EQ-014%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Conductive workpiece; 0.18 mm (0.007 in) reusable molybdenum wire; deionized water with the specified additive for the 434W (do not transfer the pure-water 434WW specification). On-board CAD/CNC instructions, USB/LAN DXF and MDI inputs. Flyer lists 220 V, three-phase, 60 Hz, 3–5 kVA input for the four-axis family, with no chiller or air-pressure requirement. 434W travel: X 400, Y 320, Z 410 mm; maximum workpiece mass 600 kg.
Source: Manuals/EDMMax Fast Wire Flyer (new).pdf; I, PDF pp. 1–2, visually reviewed, and the exact 434W seller listing.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-014"/>
  </rdf:Description>
