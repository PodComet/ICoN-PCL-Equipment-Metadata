  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P35">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#Route"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#ManufacturingProcess"/>
    <dct:identifier>P35</dct:identifier>
    <rdfs:label>Rotary swaging and induction flash annealing of nanoprecipitate-strengthened alloy</rdfs:label>
    <skos:notation>P35</skos:notation>
    <icon:associationBasis>Reviewed methods of 10.1038/s43246-025-00736-z. Conceptual sequence only; unnamed equipment stays class-level. Bulk magnesium alloy containing nanosized Al2Ca precipitates. Does not manufacture free N01 nanoparticles; 18 micrometre bulk grains are not nanograins. Conventional salt-bath comparison arm is excluded. Curator-added M82–M88 planning alternatives are distinguished from the article-reported apparatus; exact-model compatibility is not established.</icon:associationBasis>
  </rdf:Description>
