  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M43-06">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#InputOutputProfile"/>
    <dct:identifier>M43-06</dct:identifier>
    <rdfs:label>Genizer GJE-3000mL — input/output metadata</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv"/>
    <icon:inputDescription>Lipid formulation and membrane: Lipid suspension/emulsion and track-etched membrane; states: Membrane size and formulation are user-selected; material compatibility requires review; phase: Liquid suspension/emulsion
Pressurized drive gas: Compressed air/inert-gas drive described; model pressure rating must be respected; states: Gas connected/isolated; regulator controls applied pressure; phase: Gas
Pressure capacity: 800 psi maximum in current model-column specification; states: Pressure is continuous, not an enumerated command state; source conflict requires resolution
Jacket temperature control: Jacketed vessel for external heating/cooling; current family page lists 80 °C maximum; states: External temperature-control configuration; inlet conditions not fully specified; phase: Heat-transfer fluid not specified</icon:inputDescription>
    <icon:outputDescription>Extruded formulation: Liposome/lipopolyplex suspension after passage through selected membrane; states: Processed suspension; actual particle-size distribution/yield requires measurement; phase: Liquid suspension</icon:outputDescription>
    <icon:measuringUnitsDescription>mL; nm; psi; °C</icon:measuringUnitsDescription>
    <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
    <icon:sourceSheet>Sheet1</icon:sourceSheet>
    <icon:sourceRow>388</icon:sourceRow>
    <icon:sourceModel>Genizer GJE-3000mL</icon:sourceModel>
    <icon:importedDate>2026-10-30</icon:importedDate>
    <dct:references rdf:resource="https://www.genizer.com/u_file/2206/file/7e2bf4053a.pdf"/>
    <dct:references rdf:resource="https://www.genizer.com/jacketed-liposome-extruder_p0005.html"/>
  </rdf:Description>
