  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/M38-02%3Aoutputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Output and output states</schema:name>
    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Electron-microscopy images; optional analytical-detector results require the documented detector configuration. Documented readouts/functions: elemental analysis (configured detector).
Source: Manuals/thermo-scientific-axia-chemisem-datasheet-ds0354.pdf, PDF p. 1.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M38-02"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-041">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#InputOutputProfile"/>
    <dct:identifier>REQ-EQ-041</dct:identifier>
    <rdfs:label>SYNRAD Series48 Model 48-1 — input/output metadata</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv"/>
    <icon:inputDescription>DC electrical power, specified cooling and external CTRL PWM command. Command LOW 0–0.5 VDC=beam off; HIGH 3.5–10 VDC=beam on, subject to interlocks/faults. Standard PWM 5 kHz, maximum 20 kHz; duty cycle controls power. Analog 0–10 V / 4–20 mA control requires a UC-2000 intermediary.
Source: H, PDF pp. 16, 38–39, 44–49.</icon:inputDescription>
    <icon:outputDescription>CO₂ laser beam (enabled/disabled by gating, shutter/interlocks and fault shutdown). Temperature warning at DB-9 pin 5 goes LOW at 54±2 °C and remains low until temperature drops below the specified reset threshold. Other outputs depend on connector/model configuration.
Source: H, PDF pp. 16, 38–39, 44–49.</icon:outputDescription>
    <icon:measuringUnitsDescription>V DC; kHz/Hz (PWM repetition); % (duty cycle); µs (pulse timing); °C/°F (thermal conditions); µm (optical wavelength); mA (UC-2000-mediated analog control)
Source: H, PDF pp. 16, 38–39, 44–49.</icon:measuringUnitsDescription>
    <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
    <icon:sourceSheet>Sheet1</icon:sourceSheet>
    <icon:sourceRow>28</icon:sourceRow>
    <icon:sourceModel>SYNRAD Series48 Model 48-1</icon:sourceModel>
    <icon:importedDate>2026-10-30</icon:importedDate>
    <dct:references rdf:resource="https://novanta.com/precision-manufacturing/wp-content/uploads/sites/28/2026/04/48_Series_Novanta_Product_Manual_7.27_v2_Complete.pdf"/>
  </rdf:Description>
