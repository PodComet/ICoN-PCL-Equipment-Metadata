  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/EXT-M84-089170928D40%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Load introduced through the opening and quench medium held in a 3-gallon steel tank; manual steel lid (open/closed). The page does not prescribe a medium, temperature program or powered controls.
Source: I, Quench Tank product specifications.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M84-089170928D40"/>
