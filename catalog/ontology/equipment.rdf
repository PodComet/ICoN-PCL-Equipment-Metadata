  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/M20-03%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Sample and a suitable process tube; vacuum or flowing gas through the installed flanges. Temperature program contains up to 30 temperature/time segments. Power-lock and furnace relay turn on/off; controller commands enter RUN, HOLD/resume or STOP. The series manual calls for a configured 208–240 V single-phase line in 110 V regions. Gas-pressure limits and atmosphere restrictions must follow the exact tube/flange configuration.
Source: Manuals/MTI OTF-1200X__linked-manual__94143f6f5d.pdf, PDF pp. 4, 8, 11–17, 20–21.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M20-03"/>
  </rdf:Description>
