    <schema:name>Output and output states</schema:name>
    <schema:propertyID>outputs_and_states</schema:propertyID>
    <schema:value>Sample mass versus temperature/time; interpretation depends on analysis and conditions. Documented readouts/functions: sample mass/change versus temperature/time. Family document; numeric limits/options must be checked for this variant.
Source: Manuals/TGA55XX-site-prep.pdf, PDF p. 1, 2.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M42-04"/>
  </rdf:Description>
