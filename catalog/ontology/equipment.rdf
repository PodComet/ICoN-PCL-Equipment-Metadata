    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Substrate and sputter targets; process-gas supply, vacuum-pump connections and RF/DC sputtering power. The brochure lists two 2-inch magnetron cathodes with independent shutters, 500 W RF and 1 kW DC supplies, and substrate rotation adjustable from 0 to 25 rpm. A microprocessor PLC controls vacuum valves and auto-pump/auto-vent sequencing with software interlocks. The optional DVO/CS automation package is not assumed installed.
Source: Manuals/Discovery-18.pdf, PDF pp. 1 and 4, visually reviewed.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M23-09"/>
  </rdf:Description>
