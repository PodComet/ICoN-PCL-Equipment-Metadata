  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-property/M35-05%3Ainputs_and_states">
    <rdf:type rdf:resource="https://schema.org/PropertyValue"/>
    <schema:name>Input and input states</schema:name>
    <schema:propertyID>inputs_and_states</schema:propertyID>
    <schema:value>Sample/reference in appropriate UV-Vis cells or installed solid-sample accessories; wavelength scan, variable slit width, signal averaging/integration and photometric method. Temperature-controlled cell hardware and reflectance/film accessories are options, not assumed installed. The brochure identifies Cary 100 operation at 190–900 nm; electrical/control-state maps are not provided.
Source: Manuals/Agilent Cary 100.pdf, PDF pp. 2, 4–10.</schema:value>
    <prov:wasDerivedFrom rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M35-05"/>
  </rdf:Description>
