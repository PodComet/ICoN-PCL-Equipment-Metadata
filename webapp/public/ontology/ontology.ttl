<https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/step/P06%3A3> <https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON> "{\"required_branches\":[[\"M85\"],[\"M61\"]],\"optional_category_ids\":[],\"unresolved_required_equipment\":false,\"readiness_review_required\":true,\"notes\":\"Curator functional review 2026-10-17. Choose M85 wet development OR M61 dry residual-layer clearing for a compatible imprint route. The wet branch now has its own class instead of an empty branch. Match developer chemistry and the preceding patterning route; wet benches and dry plasma tools are not interchangeable.\",\"allowed_subtypes_by_category\":{\"M85\":[\"wafer_wet_processing\"],\"M61\":[\"Dry plasma etching / plasma processing\",\"Dry plasma / atomic-layer etching\"]},\"when_selected\":[{\"category_id\":\"M89\",\"required_branches\":[[]],\"notes\":\"Two-photon branch: compatible photopolymer development/rinse/post-cure must be specified. The metal-pattern etch/transfer branch is not required for this planning alternative.\"}]}" .
