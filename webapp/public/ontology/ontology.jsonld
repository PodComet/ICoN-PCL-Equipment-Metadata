      {
        "@value": "claim_checked"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "Registry issue date is2020-10-02; electronic article/JATS date is2020-09-30. Existing P21 is laser cold-wall CVD; P26 specifically robot-assisted arrays. Neither should inherit this entire recipe as exact source support. M-class placement is curator interpretation; no unnamed commercial model is validated."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#sourceLocator": [
      {
        "@value": "Materials and Methods > NP synthesis, size selection, and collection; CNT growth on substrate and FCCVD growth; Aerosol characterization, AFM, HRTEM, ED, XRD, and Raman mapping (JATS sec11–sec14)"
      }
    ]
  },
