    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON": [
      {
        "@value": "{\"required_branches\": [[\"M85\"], [\"M115\"]], \"optional_category_ids\": [], \"unresolved_required_equipment\": false, \"readiness_review_required\": true, \"notes\": \"Development and rinse remain operations with no separate machine identity established; do not omit the operations or invent instruments. Curator implementation 2026-10-17: M85 is a required fixture/vessel class. A planning grouping; a wafer solvent bench does not automatically fit colloidal washing or gel solvent exchange. Separate subtypes and chemistry compatibility are required. These model alternatives are not asserted to have been used by the article authors. Curator extension 2026-10-18 (EVG official catalogue): Configured M115 resist processor is an alternative for this coating/development function, not solvent lift-off, cleaning or all wet chemistry. Verify the actual spin/developer module and chemistry; EVG101 OmniSpray photograph does not prove installed spin/developer tooling. These are planning alternatives, not apparatus reported by the cited source or validated model substitutions.\", \"allowed_subtypes_by_category\": {\"M85\": [\"wafer_wet_processing\"], \"M115\": [\"resist_processing_station\", \"resist_processing_track\"]}}"
      }
    ],
