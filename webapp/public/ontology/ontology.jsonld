  {
    "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/reference-link/LINK-SW17-3C5652DA8FB4",
    "@type": [
      "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#ReferenceLink"
    ],
    "http://purl.org/dc/terms/identifier": [
