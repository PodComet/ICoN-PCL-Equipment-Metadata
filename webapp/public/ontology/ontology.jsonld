      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Source-stage inputs: Segmented-flow synthesis and inline optical monitoring of cesium lead halide nanocrystals"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#batchBasis": [
      {
        "@value": "Reported source process inputs; a complete numerical batch recipe has not been curated."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#inRoute": [
      {
        "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P44"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#outputLabel": [
      {
        "@value": "CsPbBr3, CsPbI3 and mixed-halide CsPb(Br/I)3 nanocrystal dispersions"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "Source-bound planning input list, not an operating protocol. Precursor preparation and carrier streams are distinct; no flow rate is treated as consumed volume."
      }
    ]
  },
  {
    "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/formulation/P45-SOURCE-01",
    "@type": [
      "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#Formulation"
    ],
    "http://purl.org/dc/terms/identifier": [
