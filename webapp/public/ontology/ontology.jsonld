        "@value": "{\"required_branches\":[[\"M13\"],[\"M15\"],[]],\"optional_category_ids\":[],\"unresolved_required_equipment\":false,\"readiness_review_required\":true,\"notes\":\"Liquid functionalization requires centrifugation OR filtration washing. The empty branch is allowed only for the dry-treatment branch, so independent per-step slot filling cannot prove readiness.\"}"
