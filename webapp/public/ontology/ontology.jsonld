      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "An automated semibatch platform dispenses reagents with Tri-Continent C3000 syringe pumps and measures products with an Ocean Optics Flame spectrometer. A custom15-vial Geneva-wheel platform evolves gold nanospheres and nanorods, then uses optimized rods as seeds for octahedral gold nanoparticles. The exact Flame detector/grating configuration is unspecified."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#relation": [
      {
        "@value": "supports_claim"
      }
    ],
