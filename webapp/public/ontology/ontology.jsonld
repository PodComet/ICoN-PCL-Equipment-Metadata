    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "Spontaneous Raman is optional post-process characterization; MIT WITec is a curator-suggested market candidate, not apparatus reported in these papers. No required process step added. Excitation, filters, spectral range and sample compatibility require review. Coherent SRS/CARS excluded."
      }
    ],
