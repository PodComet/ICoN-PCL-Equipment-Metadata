      {
        "@value": "claim_checked"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "Source-specific configuration; no universal model capability or operating recipe asserted. P-class maps the stated source stage, not all alternative ontology steps."
      }
    ],
