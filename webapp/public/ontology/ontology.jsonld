    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Source reports this apparatus type in its manufacturing or characterization workflow. A modified Hummers oxidation prepares graphene oxide, followed by chitosan grafting, purification by membrane filtration/dialysis and protein loading. The study measures retention of protein integrity and collagenase activity under its own experimental conditions. A JPK NanoWizardII AFM is explicitly used for contact-mode characterization; manufacturing bath sonicator and centrifuge are unnamed."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#relation": [
      {
        "@value": "supports_claim"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#reviewStatus": [
      {
        "@value": "claim_checked"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "The article measures therapeutic-protein behavior; these are literature observations, not predicted properties or clinically validated guarantees for arbitrary user configurations. M-class placement is curator interpretation; no unnamed commercial model is validated."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#sourceLocator": [
      {
        "@value": "Materials and Method; Results and Discussion > Characterizations of GO and GO-CS; Figs1,7–9"
      }
    ]
