      {
        "@value": "{\"required_branches\":[[\"M37\",\"M38\",\"M41\"]],\"optional_category_ids\":[\"M93\",\"M96\"],\"unresolved_required_equipment\":false,\"readiness_review_required\":true,\"notes\":\"Each listed category represents a required class in this stage; category placement is a planning check and does not establish model or process compatibility. Optional contact profilometry of accessible films/steps; stylus force, film damage, roughness and substrate suitability require review. Not AFM or optical profilometry. Optional local surface elemental mapping for vacuum-compatible specimens; charging and beam damage must be checked. Not XPS or SEM-EDS.\"}"
      }
