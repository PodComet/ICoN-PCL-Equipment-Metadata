        "@value": "{\"required_branches\":[[\"M09\"],[\"M10\"]],\"optional_category_ids\":[\"M02\"],\"unresolved_required_equipment\":false,\"readiness_review_required\":true,\"notes\":\"Cleaning/dispersion uses probe OR bath sonication; feed mixing is permissive, not mandatory. Review suitability for the chosen liquid/dry treatment route.\"}"
