    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON": [
      {
        "@value": "{\"required_branches\": [[\"M10\", \"M24\", \"M02\"], [\"M10\", \"M115\"]], \"optional_category_ids\": [\"M22\"], \"unresolved_required_equipment\": false, \"readiness_review_required\": true, \"notes\": \"Cleaning, coating and bake are specified; hard-mask deposition alone is optional. Curator extension 2026-10-18 (EVG official catalogue): Alternative M10 cleaning plus a configured M115 coat/develop/bake track covers coating and bake. Single-chamber EVG101 is excluded from this combined bake branch; generic M24+M02 branch remains. Exact bake/chill modules and resist process must be configured. These are planning alternatives, not apparatus reported by the cited source or validated model substitutions.\", \"allowed_subtypes_by_category\": {\"M115\": [\"resist_processing_track\"]}}"
      }
    ],
