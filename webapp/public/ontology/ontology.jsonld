      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "No named manufacturing maker/model; do not create a commercial instrument identity. Sonication does not resolve probe versus bath; do not claim either exact model. Three-neck flask and nitrogen flow do not independently establish a Schlenk manifold. Named TEM, XRD, ICP-MS and electrochemical apparatus are characterization/catalytic testing, separate from manufacture. One published source used two atomistic and experimental analyses; not independent validation of app predictions. M-class placement is curator interpretation; no unnamed commercial model is validated."
      }
    ]
  },
