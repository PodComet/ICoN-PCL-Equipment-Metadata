    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON": [
      {
        "@value": "{\"required_branches\":[[\"M04\"],[\"M61\"]],\"optional_category_ids\":[\"M97\"],\"unresolved_required_equipment\":false,\"readiness_review_required\":true,\"notes\":\"Choose liquid functionalization OR compatible dry plasma treatment. This determines whether the following washing stage is required. Optional adsorption/assembly monitoring on a compatible sensor. QCM-D frequency/dissipation response is not an unqualified particle mass or an electrochemical-cell substitute.\"}"
      }
    ],
