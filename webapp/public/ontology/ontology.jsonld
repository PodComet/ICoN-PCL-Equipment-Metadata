    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#associationBasis": [
      {
        "@value": "Reviewed methods of 10.1021/acsomega.7b00759. Cu-doped ZnO films include 50–100 nm surface domes at the stated low-Cu composition; higher-Cu features extend above 100 nm. Hop 2 via the directly cited 2024 review. Curator-added M82–M88 planning alternatives are distinguished from the article-reported apparatus; exact-model compatibility is not established."
      }
    ]
  },
