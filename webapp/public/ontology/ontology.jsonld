    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "A modified Hummers oxidation prepares graphene oxide, followed by chitosan grafting, purification by membrane filtration/dialysis and protein loading. The study measures retention of protein integrity and collagenase activity under its own experimental conditions. A JPK NanoWizardII AFM is explicitly used for contact-mode characterization; manufacturing bath sonicator and centrifuge are unnamed."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#relation": [
      {
        "@value": "supports_claim"
      }
    ],
