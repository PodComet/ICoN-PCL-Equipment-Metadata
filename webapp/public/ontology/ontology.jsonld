    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON": [
      {
        "@value": "{\"required_branches\":[[\"M61\"],[\"M23\",\"M85\"]],\"optional_category_ids\":[],\"unresolved_required_equipment\":false,\"readiness_review_required\":true,\"notes\":\"Curator functional review 2026-10-17. Choose M61 etching OR the complete M23 deposition + M85 solvent lift-off branch. M85 represents wet lift-off, not deposition. Only documented solvent-processing stations are offered for the M85 slot; review resist/solvent, fire protection, exhaust and preceding patterning.\",\"allowed_subtypes_by_category\":{\"M85\":[\"solvent_processing\"]},\"when_selected\":[{\"category_id\":\"M89\",\"required_branches\":[[]],\"notes\":\"Two-photon branch: compatible photopolymer development/rinse/post-cure must be specified. The metal-pattern etch/transfer branch is not required for this planning alternative.\"}]}"
      }
    ],
