      {
        "@value": "{\"required_branches\": [[\"M24\"], [\"M115\"]], \"optional_category_ids\": [], \"unresolved_required_equipment\": false, \"readiness_review_required\": true, \"notes\": \"Each listed category represents a required class in this stage; category placement is a planning check and does not establish model or process compatibility. Curator extension 2026-10-18 (EVG official catalogue): Configured M115 resist processor is an alternative for this coating/development function, not solvent lift-off, cleaning or all wet chemistry. Verify the actual spin/developer module and chemistry; EVG101 OmniSpray photograph does not prove installed spin/developer tooling. These are planning alternatives, not apparatus reported by the cited source or validated model substitutions.\", \"allowed_subtypes_by_category\": {\"M115\": [\"resist_processing_station\", \"resist_processing_track\"]}}"
      }
