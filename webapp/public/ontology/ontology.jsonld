      {
        "@value": "claim_checked"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "The article measures therapeutic-protein behavior; these are literature observations, not predicted properties or clinically validated guarantees for arbitrary user configurations. P-class maps the stated source stage, not all alternative ontology steps."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#sourceLocator": [
      {
        "@value": "Materials and Method; Results and Discussion > Characterizations of GO and GO-CS; Figs1,7–9"
