      {
        "@value": "{\"required_branches\": [[]], \"optional_category_ids\": [\"M102\", \"M103\", \"M104\"], \"allowed_subtypes_by_category\": {}, \"unresolved_required_equipment\": false, \"readiness_review_required\": false, \"notes\": \"Institution capability-derived planning route, not an extracted experimental recipe. Preparation, growth and recovery order is curator abstraction; optional characterization branches are inferred from companion facility capabilities. Nanostructure composition/dimensions, conditions, yield and properties require separate methods evidence. Hardware maxima are not setpoints. Optional measurement configuration; not required for growth completion. Spectrographs, timing electronics and FTIR microscopes need their compatible detectors/host/optics.\", \"prerequisite_source_step_orders\": [\"3\"]}"
      }
