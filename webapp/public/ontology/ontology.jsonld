      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON": [
      {
        "@value": "{\"required_branches\": [[\"M85\"], [\"M61\"], [\"M115\"]], \"optional_category_ids\": [], \"unresolved_required_equipment\": false, \"readiness_review_required\": true, \"notes\": \"Curator functional review 2026-10-17. Choose M85 wet development OR M61 dry residual-layer clearing for a compatible imprint route. The wet branch now has its own class instead of an empty branch. Match developer chemistry and the preceding patterning route; wet benches and dry plasma tools are not interchangeable. Curator extension 2026-10-18 (EVG official catalogue): Configured M115 resist processor is an alternative for this coating/development function, not solvent lift-off, cleaning or all wet chemistry. Verify the actual spin/developer module and chemistry; EVG101 OmniSpray photograph does not prove installed spin/developer tooling. These are planning alternatives, not apparatus reported by the cited source or validated model substitutions.\", \"allowed_subtypes_by_category\": {\"M85\": [\"wafer_wet_processing\"], \"M61\": [\"Dry plasma etching / plasma processing\", \"Dry plasma / atomic-layer etching\"], \"M115\": [\"resist_processing_station\", \"resist_processing_track\"]}, \"when_selected\": [{\"category_id\": \"M89\", \"required_branches\": [[]], \"notes\": \"Two-photon branch: compatible photopolymer development/rinse/post-cure must be specified. The metal-pattern etch/transfer branch is not required for this planning alternative.\"}]}"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requiresConfigurationReview": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
