    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#requirementsJSON": [
      {
        "@value": "{\"required_branches\": [[\"M58\"], [\"M59\"], [\"M60\"], [\"M89\"], [\"M113\"]], \"optional_category_ids\": [], \"unresolved_required_equipment\": false, \"readiness_review_required\": true, \"notes\": \"Choose exactly one pattern-definition route. The chosen route must be consistent with development and transfer stages. Alternative two-photon photopolymer branch in P06, not a drop-in replacement for the electron-beam/metal recipe. Compatible resist, development and geometry must be chosen; no automatic metal etch/transfer requirement. Curator extension 2026-10-18 (EVG official catalogue): M113 offers maskless optical exposure as a separate pattern-definition route. LITHOSCALE lateral feature capability is micrometre-scale; nanoscale pattern resolution is not asserted. Match resist, geometry, development and intended thin-film application. These are planning alternatives, not apparatus reported by the cited source or validated model substitutions.\"}"
      }
    ],
