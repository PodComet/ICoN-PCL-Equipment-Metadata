      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Source-stage inputs: Repeated Kirkendall hollowing of palladium nanocrystals"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#batchBasis": [
      {
        "@value": "Reported source process inputs; a complete numerical batch recipe has not been curated."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#inRoute": [
      {
        "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P45"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#outputLabel": [
      {
        "@value": "Hollow monometallic Pd nanocrystals / nanoshells; successive H-Pd-1, H-Pd-2 and H-Pd-3 study samples"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "Source-bound planning input list, not an operating protocol. Starts from prepared Pd nanocube seeds; upstream seed synthesis is outside this input boundary."
      }
    ]
  },
