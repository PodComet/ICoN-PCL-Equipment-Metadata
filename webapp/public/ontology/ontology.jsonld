    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Control-interface example: no manufacturing recipe"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#batchBasis": [
      {
        "@value": "Not applicable: control-interface example with no protocol or material basis."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#inRoute": [
      {
        "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P43"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#outputLabel": [
      {
        "@value": "Temperature-cycled sampleplate; compositionundefined"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "Not a nanomaterial manufacturing route. A thermocycler does not identify PCR reagents, concentrations, volumes or output. Require a separately reviewed protocol before offering production components."
      }
    ]
  },
  {
    "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/formulation/P44-SOURCE-01",
    "@type": [
