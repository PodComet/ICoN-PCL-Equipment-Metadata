      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#associationBasis": [
      {
        "@value": "Reviewed methods of 10.1021/acsomega.8b01881. ZnO particles below approximately 20–25 nm on cellulose rods about 5 nm wide. Hop 2 via a directly cited 2024 review; upstream coating refers to another paper and is not independently validated here."
      }
    ]
  },
  {
    "@id": "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P40",
