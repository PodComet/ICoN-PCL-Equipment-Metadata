      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Source reports this apparatus type in its manufacturing or characterization workflow. Electrospinning a hydroxyapatite/PAN precursor followed by nitrogen-atmosphere carbonization produces hydroxyapatite-containing carbon nanofibers. The BTF-1200C vacuum tube furnace is expressly named. Further preparation incorporates myoglobin and Nafion into an electrode coating. The electrospinner is not identified by make/model."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#relation": [
      {
        "@value": "supports_claim"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#reviewStatus": [
      {
        "@value": "claim_checked"
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#scope": [
      {
        "@value": "P11 is the broad thermal-conversion route. Do not label this as the same protocol as P20: HAp-loaded PAN carbonization differs from nanocarbon-loaded polymer-mat electrospinning. Hydroxyapatite is a phosphate; do not mislabel it as a metal oxide. M-class placement is curator interpretation; no unnamed commercial model is validated."
      }
    ],
    "https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#sourceLocator": [
      {
        "@value": "Experimental Section 4.2 Instruments; 4.3 Synthesis of the HAp@CNF Nanocomposite; 4.4 electrode preparation"
      }
    ]
