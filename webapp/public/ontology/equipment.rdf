  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-012">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <dct:identifier>REQ-EQ-012</dct:identifier>
    <schema:name>Balticold Spray LTD CSM 108.02</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/balticold"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=601"/>
