    </icon:associations>
    <icon:documentationProfile>
      <icon:DocumentationProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M21-01/documentationProfile">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=202"/>
        <dct:references>
          <schema:DigitalDocument rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M21-01/documentationProfile/1">
            <dct:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#ProductPage"/>
