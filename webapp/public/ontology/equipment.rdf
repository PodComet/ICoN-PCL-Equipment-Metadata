        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=602"/>
        <dct:source rdf:resource="https://www.acepillar.com/files/abb_irb14000_manual.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Workload: mounted tool/load and robot program. Controls: Manual/Automatic mode; jog/lead-through commands; program start/stop and motors-on requests. Collision-avoidance system input is documented as HIGH=active, LOW=inactive. Other configured I/O requires the controller configuration.&#10;Source: H, PDF pp. 19–28, 32, 35, 39, 50–51.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>° (joint angles); m (distance); m/s (speed); Boolean/digital states&#10;Source: H, PDF pp. 19–28, 32, 35, 39, 50–51.</icon:measuringUnitsDescription>
        <icon:outputDescription>Arm/tool motion and controller indications. The manual lists VP_ENABLE, VP_MODEKEY, VP_MOTOPB and Collision_Avoidance in its predefined output-signal table; Collision_Avoidance uses 1=enabled, 0=disabled. Mode/position indications are available; the complete configured I/O map is not given.&#10;Source: H, PDF pp. 19–28, 32, 35, 39, 50–51.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/M"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/M-PER-SEC"/>
        <icon:sourceRow>2</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
