  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/LIT-M07-YOO2023">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>LIT-M07-YOO2023</dct:identifier>
    <schema:name>Tecan Cavro Centris</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/tecan"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=640"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/LIT-M07-YOO2023/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=640"/>
        <icon:capacity>
          <qudt:QuantityValue rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/LIT-M07-YOO2023/identity/capacity">
            <qudt:numericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5</qudt:numericValue>
            <qudt:unit rdf:resource="http://qudt.org/vocab/unit/MilliL"/>
          </qudt:QuantityValue>
        </icon:capacity>
        <icon:equipmentSubtype>Cavro Centris pump with 5 mL syringes and 3-port valves dispenses reagents for room-temperature silver nanoparticle synthesis; exact evidence is preprint SI.</icon:equipmentSubtype>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M07"/>
        <icon:recordKind>commercial_model</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/LIT-M07-YOO2023">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=635"/>
        <dct:source rdf:resource="https://www.tecan.com/hubfs/HubDB/Te-DocDB/pdf/BR_PB_OEM_CP_Cavro_Centris_Pump_395529_V3-0.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Liquid and selected syringe/valve configuration; stroke/valve commands; 24 VDC supply. Syringe/valve options determine fluid path and aliquot volume. The specification lists 1 s–50 h per stroke; communication command-state details are not enumerated.&#10;Source: I, PDF pp. 2–4 (Cavro Centris features and specifications).</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>µL/mL (syringe volume); s/h per stroke (speed); V DC/A (supply); % (accuracy/precision); °C/°F and %RH (operating conditions)&#10;Source: I, PDF pp. 2–4 (Cavro Centris features and specifications).</icon:measuringUnitsDescription>
        <icon:outputDescription>Precisely displaced/dispensed liquid aliquots through the selected valve path. No particle-production guarantee, complete electrical-output state map or logging format is specified.&#10;Source: I, PDF pp. 2–4 (Cavro Centris features and specifications).</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <icon:sourceRow>959</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
