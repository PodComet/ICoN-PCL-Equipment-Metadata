            <icon:reviewNotes>A targeted manufacturer/model successor search did not produce a usable exact-model primary-source match. The model or generation remains unresolved; no latest-model or current-availability claim is made.</icon:reviewNotes>
            <icon:successorCheckedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</icon:successorCheckedDate>
          </icon:ModelLifecycle>
