      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-041">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=625"/>
        <dct:source rdf:resource="https://novanta.com/precision-manufacturing/wp-content/uploads/sites/28/2026/04/48_Series_Novanta_Product_Manual_7.27_v2_Complete.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>DC electrical power, specified cooling and external CTRL PWM command. Command LOW 0–0.5 VDC=beam off; HIGH 3.5–10 VDC=beam on, subject to interlocks/faults. Standard PWM 5 kHz, maximum 20 kHz; duty cycle controls power. Analog 0–10 V / 4–20 mA control requires a UC-2000 intermediary.&#10;Source: H, PDF pp. 16, 38–39, 44–49.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>V DC; kHz/Hz (PWM repetition); % (duty cycle); µs (pulse timing); °C/°F (thermal conditions); µm (optical wavelength); mA (UC-2000-mediated analog control)&#10;Source: H, PDF pp. 16, 38–39, 44–49.</icon:measuringUnitsDescription>
        <icon:outputDescription>CO₂ laser beam (enabled/disabled by gating, shutter/interlocks and fault shutdown). Temperature warning at DB-9 pin 5 goes LOW at 54±2 °C and remains low until temperature drops below the specified reset threshold. Other outputs depend on connector/model configuration.&#10;Source: H, PDF pp. 16, 38–39, 44–49.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MicroM"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MicroSEC"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MilliA"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <icon:sourceRow>28</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
