    <dct:identifier>M07-01</dct:identifier>
    <schema:name>New Era NE-300 InfusionONE</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/newera"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=62"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M07-01/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=62"/>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M07"/>
        <icon:recordKind>commercial_model</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M07-01">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=62"/>
        <dct:source rdf:resource="https://www.syringepump.com/NE-300.php"/>
        <dct:source rdf:resource="https://www.syringepump.com/download/NE-300%20Just%20Infusion%20User%20Manual.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Syringe contents: Sample in a compatible syringe; compatibility not specified; states: Loaded syringe; phase: Fluid; composition not prescribed&#10;DC input: 12 V DC; 750 mA maximum; specified regulated adapter rated 1000 mA; states: Connected/disconnected&#10;Syringe diameter: 0.100–50.00 mm; states: Set while stopped&#10;Infusion rate: 0.73 µL/h (1 mL B-D syringe) to 1257 mL/h (60 mL B-D syringe); states: Numeric rate; 0.0 stops pumping; limits depend on syringe&#10;Start/stop and purge keys: Start/Stop key and reverse-purge key; states: Stopped, infusion, forward purge, reverse purge; held-key purge stops on release&#10;Power-failure restart and low-noise modes: Independent binary setup options; states: 0=disabled; 1=enabled</icon:inputDescription>
