      <schema:ImageObject rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-009/photo">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=599"/>
        <dct:source rdf:resource="https://web.ics.purdue.edu/~lou49/facilities.html"/>
        <icon:imageScope>Purdue Manufacturing for Extremes facility sheet with photos of a customized FormAlloy L2; configuration may differ from the listed unit. Optics and laser upgrades are not established by this image.</icon:imageScope>
        <icon:mediaCheckedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</icon:mediaCheckedDate>
        <schema:contentUrl rdf:resource="https://web.ics.purdue.edu/~lou49/FormAlloy.png"/>
      </schema:ImageObject>
    </schema:image>
    <icon:review>
      <icon:ReviewProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-009/review">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=599"/>
        <icon:catalogScope>requested_supplement</icon:catalogScope>
        <icon:lifecycle>
          <icon:ModelLifecycle rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-009/review/lifecycle">
            <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/model_lifecycle.csv#row=599"/>
