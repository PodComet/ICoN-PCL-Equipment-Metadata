  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/EXP-20261016-M47-PE-300">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>EXP-20261016-M47-PE-300</dct:identifier>
    <schema:name>Inovenso PE-300</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/inovenso"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=717"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/EXP-20261016-M47-PE-300/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=717"/>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M47"/>
        <icon:recordKind>commercial_model</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXP-20261016-M47-PE-300">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=708"/>
        <dct:source rdf:resource="https://www.inovenso.com/wp-content/uploads/2020/04/Inovenso_PE300_Catalog_2020.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Polymer spinning formulations, syringe-pump feeds and roll-to-roll collector substrate. Two pumps and two high-voltage supplies can independently process two polymers. Touchscreen controls and stored/recalled parameter sets; spark protection, safety relays and a safety-door option are listed.&#10;Source: I, PDF pp. 3–7.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>kV (high-voltage supplies); mm (fiber deposition width); m/min (substrate winding speed)&#10;Source: I, PDF pp. 3–7.</icon:measuringUnitsDescription>
        <icon:outputDescription>Continuous electrospun nanofibers/composite web on the collector; stored process parameter sets. The catalog does not enumerate controller signal pins, alarm states or data-export format.&#10;Source: I, PDF pp. 3–7.</icon:outputDescription>
