    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M31-10">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=310"/>
        <dct:source rdf:resource="https://www.pfeiffervacuum.com/us/assets/121347/1/Instruction%20Manual%20HiScroll%206_12_18%2C%201ph%2C%20ATEX_EN_en.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Materials/workload: Gas at the inlet and drive power; vacuum-system connections.&#10;Documented parameters/utilities: Speed setting/range (rpm), Electrical supply (V).&#10;Interfaces named: RS-485, USB. Pin directions and permitted commands require the interface section.&#10;Source-described sample/feed form: gas stream.&#10;Other per-input states/guards: not established by this functional summary.&#10;Sources: H PDF pp. 1, 53, 75.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>%; A; L/min; V; W; kg; rpm; s; °C&#10;Sources: H PDF pp. 9, 10, 19, 35, 53, 75, 77, 78 et seq..</icon:measuringUnitsDescription>
