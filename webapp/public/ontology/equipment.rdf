          <icon:ModelVariant rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-019/identity/variant">
            <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/product_families.csv#row=86"/>
            <dct:source rdf:resource="https://www.universal-robots.com/manuals/EN/TechSheets/comparison_e-series_pdf_online/comparison_e-Series_en.pdf"/>
            <icon:groupingBasis>Manufacturer e-Series platform variants. Purdue installed-unit links remain on each exact instrument record.</icon:groupingBasis>
            <icon:inProductFamily rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/product-family/PF-ur-eseries"/>
