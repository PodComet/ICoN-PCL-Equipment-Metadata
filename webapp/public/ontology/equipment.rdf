  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M07-07">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>M07-07</dct:identifier>
    <schema:name>KD Scientific Legato 200</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/kdscientific"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=68"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M07-07/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=68"/>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M07"/>
        <icon:recordKind>model_candidate</icon:recordKind>
        <icon:variant>
          <icon:ModelVariant rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M07-07/identity/variant">
            <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/product_families.csv#row=7"/>
            <dct:source rdf:resource="https://support.kdscientific.com/hc/en-us/articles/1500007825321-Legato-200-Series-Manual"/>
            <icon:groupingBasis>The 200-series manufacturer manual includes the 210 configuration. Legato 100 remains separate.</icon:groupingBasis>
            <icon:inProductFamily rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/product-family/PF-kd-legato200"/>
            <icon:reviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</icon:reviewDate>
            <icon:variantLabel>Legato 200</icon:variantLabel>
          </icon:ModelVariant>
        </icon:variant>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M07-07">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=68"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Liquid in one or two syringes, selected syringe type/diameter, infusion rate and target volume or time. Legato 200 is INFUSE ONLY; do not assign Legato 210 withdrawal or 210P/270P programming features. Supply: 100–240 VAC, 50–60 Hz. USB/RS-232 and a 15-pin I/O/TTL connector are documented for the family; the external footswitch can toggle run/stop or follow rising/falling edges. The 0–10 V speed-control input is a factory option.&#10;Source: Manuals/KDS Legato 200 Series_5617-002REV2.0.pdf, PDF pp. 6, 8, 11, 17–19, 62–65, 79, 89.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>pL/min, µL/min, mL/min and mL/h (flow selections/range); µL and mL (syringe/target volume); mm (syringe diameter); s/min/h (time); V, Hz and W (supply/optional control); TTL high/low (dimensionless). Flow limits depend on syringe size.&#10;Source: Manuals/KDS Legato 200 Series_5617-002REV2.0.pdf, PDF pp. 6, 8, 11, 17–19, 62–65, 79, 89.</icon:measuringUnitsDescription>
        <icon:outputDescription>Infused liquid; pump/run indication, programmed trigger outputs where supported, completion and stall/power-failure messages. Family TTL outputs are Boolean high/low; only functions enabled by the installed Legato 200 configuration apply. No withdrawal stream is produced by this infuse-only model.&#10;Source: Manuals/KDS Legato 200 Series_5617-002REV2.0.pdf, PDF pp. 6, 8, 11, 17–19, 62–65, 79, 89.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MilliM"/>
        <icon:sourceRow>542</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
