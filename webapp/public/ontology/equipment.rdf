  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/EXT-M94-AE8D51E118E0">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>EXT-M94-AE8D51E118E0</dct:identifier>
    <schema:name>iNano</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/kla"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=1012"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/EXT-M94-AE8D51E118E0/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=1012"/>
        <icon:equipmentSubtype>Nanoindentation and nanomechanical testing</icon:equipmentSubtype>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M94"/>
        <icon:recordKind>market_model</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/EXT-M94-AE8D51E118E0">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=1003"/>
        <dct:source rdf:resource="https://www.kla.com/wp-content/uploads/iNano-1.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Materials/workload: Specimen and indentation probe; force/displacement test program.&#10;Other per-input states/guards: not established by this functional summary.&#10;Sources: I PDF pp. 1.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>kHz; mN&#10;Sources: I PDF pp. 2, 6.</icon:measuringUnitsDescription>
        <icon:outputDescription>Indentation load/displacement data and documented derived mechanical measurements.&#10;Source-listed channels/measurands: hardness, modulus, load, depth, force, displacement.&#10;Other output-state/pin mappings: not established by this functional summary.&#10;Sources: I PDF pp. 1.</icon:outputDescription>
