      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-012/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=601"/>
