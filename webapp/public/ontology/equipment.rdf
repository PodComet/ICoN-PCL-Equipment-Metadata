  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M34-09">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>M34-09</dct:identifier>
    <schema:name>Otsuka ELSZ-2000</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/otsuka"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=340"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M34-09/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=340"/>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M34"/>
        <icon:recordKind>model_candidate</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M34-09">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=339"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Nanoparticle suspension/solution in the appropriate cell. Particle sizing requires 0.9 mL in the standard cell or 20 µL in the micro-volume cell; zeta analysis requires 0.7 mL in a standard glass cell or 130 µL in a disposable cell. Peltier temperature control is specified from 0 to 90 °C. The ELSZ-PT pH/additive autotitrator and surface-zeta accessory are optional, not assumed installed. The brochure does not provide the command, trigger or ready/alarm state map.&#10;Source: Manuals/Otsuka-ELSZ2000-brochure-Hi-Res.pdf, PDF pp. 9–11, visually reviewed.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>nm (particle size and laser wavelength); mV (zeta potential); Da/MDa (molecular weight); mL/µL (sample volume); °C (sample temperature); degrees (scattering angle); % (concentration); mW (specified laser power). Optional autotitrator pH is not treated as an installed base-instrument output.&#10;Source: Manuals/Otsuka-ELSZ2000-brochure-Hi-Res.pdf, PDF pp. 9–11, visually reviewed.</icon:measuringUnitsDescription>
        <icon:outputDescription>DLS particle size/size distribution, electrophoretic zeta potential and molecular-weight analysis by the described DLS/SLS methods. Particle-size measurement and zeta analysis use distinct optical configurations; samples, concentration and calibration affect reported results. No electrical output-state/pin map is supplied.&#10;Source: Manuals/Otsuka-ELSZ2000-brochure-Hi-Res.pdf, PDF pp. 9–11, visually reviewed.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MilliV"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/NanoM"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <icon:sourceRow>749</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
