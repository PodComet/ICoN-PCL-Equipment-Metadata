    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M35-05">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=345"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Sample/reference in appropriate UV-Vis cells or installed solid-sample accessories; wavelength scan, variable slit width, signal averaging/integration and photometric method. Temperature-controlled cell hardware and reflectance/film accessories are options, not assumed installed. The brochure identifies Cary 100 operation at 190–900 nm; electrical/control-state maps are not provided.&#10;Source: Manuals/Agilent Cary 100.pdf, PDF pp. 2, 4–10.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>nm (wavelength and spectral resolution); Abs/AU (absorbance, dimensionless); % (transmission/reflectance); °C (optional cell-temperature control).&#10;Source: Manuals/Agilent Cary 100.pdf, PDF pp. 2, 4–10.</icon:measuringUnitsDescription>
        <icon:outputDescription>Absorbance/transmittance versus wavelength; kinetics and optional accessory-dependent reflectance, film or colour analysis. The Cary 100 working absorbance range is described as beyond 4 Abs; the Cary 300’s 6 Abs claim is not assigned to this row.&#10;Source: Manuals/Agilent Cary 100.pdf, PDF pp. 2, 4–10.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/NanoM"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <icon:sourceRow>58</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
