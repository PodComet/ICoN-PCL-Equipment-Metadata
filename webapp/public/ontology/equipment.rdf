    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=603"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
