  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M23-09">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>M23-09</dct:identifier>
    <schema:name>Denton Discovery 18</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/denton"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=230"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M23-09/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=230"/>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M23"/>
        <icon:recordKind>model_candidate</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/M23-09">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=230"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Substrate and sputter targets; process-gas supply, vacuum-pump connections and RF/DC sputtering power. The brochure lists two 2-inch magnetron cathodes with independent shutters, 500 W RF and 1 kW DC supplies, and substrate rotation adjustable from 0 to 25 rpm. A microprocessor PLC controls vacuum valves and auto-pump/auto-vent sequencing with software interlocks. The optional DVO/CS automation package is not assumed installed.&#10;Source: Manuals/Discovery-18.pdf, PDF pp. 1 and 4, visually reviewed.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>Torr (vacuum pressure); L/s and cfm (pumping speed); rpm (substrate rotation); W/kW (RF/DC power); V and A (DC supply rating); in (target/substrate geometry).&#10;Source: Manuals/Discovery-18.pdf, PDF pp. 1 and 4, visually reviewed.</icon:measuringUnitsDescription>
        <icon:outputDescription>Sputtered coating on the substrate; digital mass-flow and vacuum-pressure readouts. Valve/pump/vent and shutter operation are described, but the brochure does not enumerate the electrical ready/alarm/pin-state map.&#10;Source: Manuals/Discovery-18.pdf, PDF pp. 1 and 4, visually reviewed.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/REV-PER-MIN"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/TORR"/>
        <icon:sourceRow>270</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
    <icon:associations>
      <icon:CatalogAssociations rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/M23-09/associations">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=230"/>
        <icon:associationBasis>inherited family-level curated route; model-specific suitability not established</icon:associationBasis>
        <icon:catalogMaterial rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/N09"/>
        <icon:catalogProcess rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/route/P06"/>
      </icon:CatalogAssociations>
    </icon:associations>
