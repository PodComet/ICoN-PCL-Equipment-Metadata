  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-043">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>REQ-EQ-043</dct:identifier>
    <schema:name>Tracer 2.0 Mobile Platform</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/agilexrobotics"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=631"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-043/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=631"/>
        <icon:equipmentSubtype>Mobile base; no robot arm specified</icon:equipmentSubtype>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M62"/>
        <icon:legacyCategoryID>X-ROB</icon:legacyCategoryID>
        <icon:recordKind>commercial_model</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-043">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=627"/>
        <dct:source rdf:resource="https://static.generation-robots.com/media/user-manual-tracer-2-0-agilex-robotics.pdf"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Workload: payload mounted on the mobile base (rated 100 kg). Power: 24 V battery. Commands: forward/reverse linear velocity and left/right angular velocity through CAN 2.0B at 500 kbit/s or the RC handset; emergency stop must be released. Feedback modes are standby=0x00, CAN=0x01 and RC=0x02. RC takes priority over CAN. Motion-command timeout after 500 ms sets velocity to zero.&#10;Source: H, PDF pp. 3, 7–8, 11–19, 22–26, 34.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>mm/s (CAN linear velocity); 0.001 rad/s (CAN angular-velocity scaling); m/s (rated travel speed); rpm (motor feedback); V (battery, reported with ×10 integer scaling); A (motor current); °C (temperature); kg (payload); ms (command timing); kbit/s (CAN bitrate); coded/Boolean status flags (dimensionless)&#10;Source: H, PDF pp. 3, 7–8, 11–19, 22–26, 34.</icon:measuringUnitsDescription>
        <icon:outputDescription>Chassis translation/rotation; CAN feedback for actual linear/angular velocity, battery voltage, chassis/control-mode status, fault bits and motor information. Fault bits use 0=normal/no alarm and 1=fault/alarm. Feedback motor speed is in rpm; the side interface also provides 24 V expansion power.&#10;Source: H, PDF pp. 3, 7–8, 11–19, 22–26, 34.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/A"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/M-PER-SEC"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MilliM-PER-SEC"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/MilliSEC"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/REV-PER-MIN"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <icon:sourceRow>3</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
