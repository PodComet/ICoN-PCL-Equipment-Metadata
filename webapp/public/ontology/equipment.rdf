  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M100">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=99"/>
    <skos:notation>M100</skos:notation>
    <skos:prefLabel>Molecular-beam epitaxy systems</skos:prefLabel>
    <icon:associationBasis>Integrated MBE growth systems; source/cracker/plasma configurations must match the material system. Not CVD, ALD or sputtering. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M101">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=100"/>
    <skos:notation>M101</skos:notation>
    <skos:prefLabel>Optical grating spectrometers for photoluminescence</skos:prefLabel>
    <icon:associationBasis>Spectrograph components used within PL benches. Excitation sources, detectors, collection optics and cryostats remain separate; a bare spectrograph is not a complete PL system. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M102">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=101"/>
    <skos:notation>M102</skos:notation>
    <skos:prefLabel>Semiconductor electrical and optoelectronic probe stations</skos:prefLabel>
    <icon:associationBasis>Chip/wafer probe stations with configurable measurement instruments. Cryogenic and high-frequency setups remain distinct; station does not include every analyzer by default. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M103">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=102"/>
    <skos:notation>M103</skos:notation>
    <skos:prefLabel>Semiconductor parameter analyzers</skos:prefLabel>
    <icon:associationBasis>I–V device characterization electronics. Not electrochemical potentiostats or mechanical test systems. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M104">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=103"/>
    <skos:notation>M104</skos:notation>
    <skos:prefLabel>Precision LCR and impedance meters</skos:prefLabel>
    <icon:associationBasis>Electrical component/device capacitance, inductance and impedance measurement. Not optical spectroscopy or electrochemical-cell control. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M105">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=104"/>
    <skos:notation>M105</skos:notation>
    <skos:prefLabel>Lock-in amplifiers</skos:prefLabel>
    <icon:associationBasis>Phase-sensitive detection electronics used within a configured measurement chain. Not an autonomous PL spectrometer or process controller. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M106">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=105"/>
    <skos:notation>M106</skos:notation>
    <skos:prefLabel>Time-correlated single-photon counting electronics</skos:prefLabel>
    <icon:associationBasis>Photon-event timing electronics; optical wavelength range depends on external detectors and optics. Not a stand-alone spectrometer or light source. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M107">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=106"/>
    <skos:notation>M107</skos:notation>
    <skos:prefLabel>Optical microscopy and spectroscopy cryostats</skos:prefLabel>
    <icon:associationBasis>Cryogenic sample environments for optical measurement, distinct from grid vitrification, freeze drying and growth furnaces. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M108">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=107"/>
    <skos:notation>M108</skos:notation>
    <skos:prefLabel>Infrared microscopy accessories and stations</skos:prefLabel>
    <icon:associationBasis>FTIR microscope/optical sampling hardware requiring a compatible spectrometer. Does not independently replace a complete FTIR spectrometer. UCLA capability review; no universal recipe or validated model substitution.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M109">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=108"/>
    <skos:notation>M109</skos:notation>
    <skos:prefLabel>Nanoparticle beam mass filters</skos:prefLabel>
    <icon:associationBasis>In-line mass analysis and selection of nanoparticle beams in vacuum. Distinct from aerosol electrical-mobility classifiers, particle detectors and complete nanoparticle sources. Manufacturer catalogue relevance plus curator classification; exact host-system compatibility and process suitability require configuration review.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M11">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=12"/>
    <skos:notation>M11</skos:notation>
    <skos:prefLabel>Rotor-stator homogenizer</skos:prefLabel>
    <icon:associationBasis>curated route associations in supplied PDF; not model-specific validation</icon:associationBasis>
    <icon:sourcePage>43</icon:sourcePage>
    <icon:sourceSha256>29c6800c7bc96c4affff67aa2f8d2d794f1736965287faf584c3374fdd3eca41</icon:sourceSha256>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M110">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=109"/>
    <skos:notation>M110</skos:notation>
    <skos:prefLabel>RF atom sources for vacuum deposition</skos:prefLabel>
    <icon:associationBasis>Neutral atomic-species source components for configured vacuum deposition, including nitride MBE and nitride PLD. Not complete MBE/PLD systems and not ion-beam sources. Manufacturer catalogue relevance plus curator classification; exact host-system compatibility and process suitability require configuration review.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M111">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=110"/>
    <skos:notation>M111</skos:notation>
    <skos:prefLabel>Broad-beam RF ion sources</skos:prefLabel>
    <icon:associationBasis>Vacuum ion-source components for surface modification, ion-beam etching and assisted deposition. Not a complete RIE reactor, focused-ion-beam microscope or ion-implantation system. Manufacturer catalogue relevance plus curator classification; exact host-system compatibility and process suitability require configuration review.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M112">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=111"/>
    <skos:notation>M112</skos:notation>
    <skos:prefLabel>UHV substrate stages and manipulators</skos:prefLabel>
    <icon:associationBasis>Sample positioning, rotation, bias and thermal-environment accessories inside compatible UHV systems. Not a general robot, growth chamber, furnace or complete deposition system. Manufacturer catalogue relevance plus curator classification; exact host-system compatibility and process suitability require configuration review.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M113">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=113"/>
    <skos:notation>M113</skos:notation>
    <skos:prefLabel>Maskless optical lithography systems</skos:prefLabel>
    <icon:associationBasis>Digital optical exposure without a photomask. Not a mask aligner, electron-beam writer or nanoimprint press. Micrometre lateral patterning capability does not establish nanoscale resolution. Official catalogue capability with curator classification; not an assertion of apparatus used in an article.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M114">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=114"/>
    <skos:notation>M114</skos:notation>
    <skos:prefLabel>Wafer overlay and film-thickness metrology systems</skos:prefLabel>
    <icon:associationBasis>Wafer process inspection, alignment/critical-dimension or film-thickness measurement, depending on configured model. Not AFM, a generic controller, or a claim that every model measures all quantities. Official catalogue capability with curator classification; not an assertion of apparatus used in an article.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M115">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentCategory"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/categories.csv#row=115"/>
    <skos:notation>M115</skos:notation>
    <skos:prefLabel>Wafer resist coating and development systems</skos:prefLabel>
    <icon:associationBasis>Configured multifunction resist-processing stations/tracks combining coating, development and optionally bake/chill. Distinct from a bare benchtop spin coater and its price benchmarks. Exact modules, wafer geometry, resist and developer compatibility require review. Official catalogue capability with curator classification; not an assertion of apparatus used in an article.</icon:associationBasis>
  </skos:Concept>
  <skos:Concept rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M116">
