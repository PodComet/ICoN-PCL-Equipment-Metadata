  <rdf:Description rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-024">
    <rdf:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#EquipmentModel"/>
    <rdf:type rdf:resource="https://schema.org/ProductModel"/>
    <dct:identifier>REQ-EQ-024</dct:identifier>
    <schema:name>Standard Bots Core</schema:name>
    <schema:manufacturer rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/manufacturer/standardbots"/>
    <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=613"/>
    <dct:isPartOf rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/dataset/equipment"/>
    <icon:identity>
      <icon:IdentityProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-024/identity">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=613"/>
        <icon:equipmentSubtype>Manipulator arm</icon:equipmentSubtype>
        <icon:inCategory rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/category/M62"/>
        <icon:legacyCategoryID>X-ROB</icon:legacyCategoryID>
        <icon:recordKind>commercial_model</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-024">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=609"/>
        <dct:source rdf:resource="https://corehelp.standardbots.com/1-introduction.html"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Workload: end effector/workpiece within the 18 kg payload rating; six-axis motion program. Supported operating modes: collaborative or high-speed non-collaborative. Control box: 16 digital inputs and 4 analogue inputs, stated as 24 V tolerant; TCP/IP, Modbus TCP and EtherNet/IP are listed. Tool M8 8-pin connector: 2 digital inputs and 2 analogue inputs (24 V tolerant); RS-485/UART up to 10 Mbit/s. Controller supply: 90–264 VAC, 47–63 Hz; program/payload-dependent power 25–1500 W. Tool-I/O hardware is listed, but the April 2026 footnote says software support was forthcoming; confirm installed firmware. Input HIGH/LOW thresholds and analogue ranges/scaling are not specified.&#10;Source: Manuals2/6ad0baa701069695bb0452a4_New Core Specs 202604.pdf, PDF p. 2.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>kg (payload); m/mm (reach, repeatability and geometry); degrees and °/s (joint range/speed); W/kW (power); V/VAC and A (electrical supply/I/O ratings); Hz (mains frequency); °C (temperature); %RH (humidity); Mbit/s (serial data rate). Channel counts/DOF are dimensionless. These are published operating/specification units; analogue scaling and digital logic thresholds are not given.&#10;Source: Manuals2/6ad0baa701069695bb0452a4_New Core Specs 202604.pdf, PDF p. 2.</icon:measuringUnitsDescription>
        <icon:outputDescription>Commanded robot/tool motion, rated reach 1.3 m, maximum joint speed 435°/s, repeatability ±0.025 mm. Control box: 16 digital outputs, 24 V / 0.7 A continuous; combined supply limit 3 A with internal power or 12 A with external power. Tool: 2 digital outputs, open-drain or push-pull (listed 1 A rating); zero analogue outputs; tool power 12/24 V, 3 A continuous maximum. The tool hardware/software-support caveat also applies to these outputs. Default states, per-pin assignments, fault/ready meanings and calibrated position/force telemetry fields are not supplied by the sheet.&#10;Source: Manuals2/6ad0baa701069695bb0452a4_New Core Specs 202604.pdf, PDF p. 2.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/HZ"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
        <icon:sourceRow>26</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
    <icon:associations>
      <icon:CatalogAssociations rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment/REQ-EQ-024/associations">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=613"/>
        <icon:associationBasis>curated supplement; material/process links are proposed context, not verified model capability</icon:associationBasis>
      </icon:CatalogAssociations>
    </icon:associations>
