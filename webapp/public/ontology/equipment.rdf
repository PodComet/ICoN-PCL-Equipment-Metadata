    <icon:claim>The lid_position property can report open, closed, in_between or unknown.</icon:claim>
    <icon:classification>manufacturer_fact</icon:classification>
    <icon:scope>Model-bound control documentation; not a validation of a user sequence.</icon:scope>
  </icon:SourceEvidence>
