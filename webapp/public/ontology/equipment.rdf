        <icon:recordKind>model_identity_unresolved</icon:recordKind>
      </icon:IdentityProfile>
    </icon:identity>
    <icon:inputOutputProfile>
      <icon:InputOutputProfile rdf:about="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/id/equipment-io/REQ-EQ-012">
        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment_io.csv#row=597"/>
        <dct:source rdf:resource="https://balticoldspray.com/products/csm108-2/#specifications"/>
        <dct:source rdf:resource="https://dymet.ee/products-2/csm1082/"/>
        <icon:importedDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-30</icon:importedDate>
        <icon:inputDescription>Material inputs: metal powder, e.g. zinc, aluminium, copper, nickel or tin, and a substrate. Utilities: single-phase 230 V / 16 A and compressed air approximately 400 L/min. Manufacturer lists 5–8 bar operating pressure; the Dymet page lists 6–8 bar, so confirm the installed system rating. Operating mode: manual spraying or CNC integration. Dymet lists gas-temperature operation at 100–600 °C; detailed command/pin states are not supplied.&#10;Source: H and I, CSM 108.2 product specifications; reviewed 2026-10-30.</icon:inputDescription>
        <icon:inputOutputStatus>catalog_io_row</icon:inputOutputStatus>
        <icon:measuringUnitsDescription>bar (air pressure); L/min or m³/min (airflow); °C (gas-temperature specification); V and A (electrical supply); m/s (particle speed listed by Dymet). These are operating/specification quantities; no integrated readout or signal scaling is established.&#10;Source: H and I, CSM 108.2 product specifications; reviewed 2026-10-30.</icon:measuringUnitsDescription>
        <icon:outputDescription>Cold-sprayed metal coating or built-up workpiece; gas/powder jet exits the spray nozzle. Deposited thickness and quality depend on feedstock and settings. Neither linked product page gives an electrical output/telemetry-state map.&#10;Source: H and I, CSM 108.2 product specifications; reviewed 2026-10-30.</icon:outputDescription>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/BAR"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/DEG_C"/>
        <icon:sourceRow>4</icon:sourceRow>
        <icon:sourceSha256>c22c4681926fb5b28876a7db7c55d9e527e4ad9fada4ab8774b9aa2b9538bcab</icon:sourceSha256>
        <icon:sourceSheet>Sheet1</icon:sourceSheet>
      </icon:InputOutputProfile>
    </icon:inputOutputProfile>
