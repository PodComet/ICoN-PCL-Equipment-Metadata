        <prov:wasDerivedFrom rdf:resource="https://raw.githubusercontent.com/PodComet/ICoN-PCL-Equipment-Metadata/main/catalog/equipment.csv#row=623"/>
        <icon:associationBasis>curated supplement; material/process links are proposed context, not verified model capability</icon:associationBasis>
