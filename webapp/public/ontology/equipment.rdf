        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/NanoM"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/TORR"/>
        <icon:reportedUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
