            <dct:type rdf:resource="https://github.com/PodComet/ICoN-PCL-Equipment-Metadata/ontology#ModelEvidence"/>
            <schema:url rdf:resource="https://engineering.jhu.edu/MCP/equipment/formalloy-l2-directed-energy-deposition-ded-system/"/>
